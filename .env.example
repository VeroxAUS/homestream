# HomeStream configuration template.
#
# Copy this file to `.env` in the repository root (`node scripts/bootstrap.mjs` does it for you when `.env` does not
# exist yet) and remove the leading `# ` from the lines you want to set. `.env` is ignored by git: never commit it,
# never paste its values into issues, logs or pull requests.
#
# Packaged desktop builds read %APPDATA%\HomeStream\config.env instead, with the same keys.
# A variable in the process environment overrides the same key in the file. Restart the server after editing.
#
# This file only contains comments. Every key below is read by the code; a drift test
# (apps/server/test/envExample.test.ts) fails when a key is missing here.

# ---------------------------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------------------------

# AIOStreams gateway manifest URL (it embeds your encrypted gateway configuration, so treat it as a secret).
# GATEWAY_MANIFEST_URL=

# TMDB API Read Access Token (themoviedb.org > Settings > API > "API Read Access Token").
# TMDB_READ_TOKEN=

# ---------------------------------------------------------------------------------------------------------------
# TorBox
# ---------------------------------------------------------------------------------------------------------------

# TorBox API key (torbox.app > Settings). Used for health checks and for caching titles that have no cached stream.
# TORBOX_API_KEY=

# TorBox API origin. Default https://api.torbox.app. Only tests and local stub servers change it.
# TORBOX_API_URL=

# ---------------------------------------------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------------------------------------------

# HTTP port. Default 8600. 0 picks a free port.
# PORT=

# Port of the loopback-only source proxy. Default is PORT + 50. 0 picks a free port.
# SOURCE_PROXY_PORT=

# Name shown to clients on the network. Default "HomeStream on <computer name>".
# SERVER_NAME=

# Directory holding the SQLite database and server.log. Default E:\HomeStream\data (set your own path).
# DATA_DIR=

# Directory for HLS segments while a session plays. Default E:\HomeStream\transcode (set your own path).
# TRANSCODE_DIR=

# Disk budget for transcoded segments in GB. Default 20.
# TRANSCODE_MAX_GB=

# The disk health check warns when the fuller of the TRANSCODE_DIR and DATA_DIR drives has less than this many GB free. Default 20.
# Keep it above 5, the level where the check becomes an error. Invalid values (not a number, negative) use the default.
# DISK_WARN_FREE_GB=

# Directory with the built web UI. Default apps/web/dist next to the server.
# HOMESTREAM_WEB_DIR=

# Set to off to stop the server announcing itself on the local network (mDNS), for an extra server on the same PC that
# would otherwise clash with the first one's name. Default on.
# HOMESTREAM_MDNS=

# Console and server.log verbosity: debug, info, warn or error. Default info.
# LOG_LEVEL=

# ---------------------------------------------------------------------------------------------------------------
# ffmpeg
# ---------------------------------------------------------------------------------------------------------------

# Path to ffmpeg and ffprobe when they are not on PATH. Default "ffmpeg" and "ffprobe".
# FFMPEG_PATH=
# FFPROBE_PATH=

# Thread cap for ffmpeg jobs whose filters run on the GPU. Default 4.
# FFMPEG_THREADS=

# Thread cap for ffmpeg jobs with CPU filters (software subtitle burn-in, CPU tone mapping). Default 8.
# FFMPEG_BURN_THREADS=

# Working-set limit per ffmpeg process in MiB; the watchdog stops a process above it. Default 4096.
# FFMPEG_MAX_RSS_MB=

# Whether the ffmpeg health check runs its 1 s NVENC test encode: 0, false, off or no turn it off. Default on.
# HEALTH_NVENC_TEST=

# ---------------------------------------------------------------------------------------------------------------
# Download limits (the household shares the connection)
# ---------------------------------------------------------------------------------------------------------------

# Hard cap on all upstream downloads together, in megabits per second. Minimum 5, default 150.
# MAX_DOWNLOAD_MBPS=

# The encoder reads at most this many seconds ahead of the player before it waits. Default 180.
# READ_AHEAD_SEC=

# Reading resumes once the lead drops below this many seconds. Must be below READ_AHEAD_SEC. Default 120.
# READ_AHEAD_RESUME_SEC=

# ---------------------------------------------------------------------------------------------------------------
# Runtime switches
# ---------------------------------------------------------------------------------------------------------------

# Path of an env file to load instead of .env or %APPDATA%\HomeStream\config.env. Mostly used by tests.
# HOMESTREAM_ENV_FILE=

# Set to 1 by the packaged desktop app: the server then ignores the repository .env.
# HOMESTREAM_PACKAGED=

# Set to off to disable all telemetry (Sentry and PostHog) regardless of the keys below. See docs/PRIVACY.md.
# HOMESTREAM_TELEMETRY=

# ---------------------------------------------------------------------------------------------------------------
# Telemetry (optional; telemetry stays off while the matching key is empty)
# ---------------------------------------------------------------------------------------------------------------

# Sentry DSNs, one per project: server, web UI (also used by the desktop shell) and the TV app. The web DSN and the PostHog
# key are read when the web UI is built and baked into the bundle; a build without them sends nothing.
# SENTRY_DSN_SERVER=
# SENTRY_DSN_WEB=
# SENTRY_DSN_TV=

# Environment name on Sentry events. Default development for the server (production for the packaged app and for web builds).
# SENTRY_ENVIRONMENT=

# Release name of the web UI build. Default homestream@<version of apps/web>. Baked in at build time.
# SENTRY_RELEASE=

# Set to 1 for a release build of the web UI: uploads source maps to Sentry (needs SENTRY_AUTH_TOKEN and SENTRY_ORG) and
# removes them from dist. Plain builds never contain source maps.
# HOMESTREAM_RELEASE_BUILD=

# Set to 1 to build the web UI for the end-to-end tests: it enables the dev-only telemetry test trigger (?__telemetry_test=<id>).
# HOMESTREAM_TELEMETRY_STUB=

# Sentry organization slug.
# SENTRY_ORG=

# Sentry organization token for CI releases and source maps. Secret. Used only in CI.
# SENTRY_AUTH_TOKEN=

# Sentry personal token for reading issues and managing alert rules. Secret.
# SENTRY_API_TOKEN=

# PostHog project key and ingestion host.
# POSTHOG_API_KEY=
# POSTHOG_HOST=

# PostHog personal API key, only for creating feature flags from the command line. Secret.
# POSTHOG_PERSONAL_API_KEY=

# ---------------------------------------------------------------------------------------------------------------
# Repository secrets (GitHub Actions only; not needed to run HomeStream locally)
# ---------------------------------------------------------------------------------------------------------------

# Factory API key that lets the droid-wiki-refresh workflow run `droid exec /wiki`. Secret. Set it only as a GitHub
# repository secret, never in a local .env; see docs/wiki.md.
# FACTORY_API_KEY=

# Optional fine-grained token (contents and pull requests write) so the wiki pull request triggers the required
# checks. Secret. GitHub repository secret only; see docs/wiki.md.
# FACTORY_WIKI_PR_TOKEN=

# ---------------------------------------------------------------------------------------------------------------
# Development tooling
# ---------------------------------------------------------------------------------------------------------------

# Directory where tests create temporary data. Default E:\HomeStream\test-tmp (set your own path, e.g. a temp dir).
# HOMESTREAM_TEST_ROOT=

# Path to the gitleaks binary used by the pre-commit secret scan. Default: found on PATH, else a built-in scan.
# GITLEAKS_PATH=
