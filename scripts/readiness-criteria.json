{
  "description": "Factory Agent Readiness criteria (81 IDs) with the inferred level, scope and checker used by scripts/readiness-audit.mjs. Levels are inferred from public readiness reports; see the readiness plan.",
  "defaultApps": ["server"],
  "libraries": ["shared"],
  "criteria": [
    {
      "id": "formatter",
      "pillar": "Style",
      "level": 1,
      "scope": "app",
      "tv": {
        "type": "all",
        "checks": [
          {
            "type": "appContains",
            "pattern": "ktlint|spotless|detekt",
            "pathRegex": "(^|/)build\\.gradle(\\.kts)?$"
          }
        ]
      },
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": [".prettierrc"]
          },
          {
            "type": "rootScripts",
            "scripts": ["format:check"]
          }
        ]
      }
    },
    {
      "id": "lint_config",
      "pillar": "Style",
      "level": 1,
      "scope": "app",
      "tv": {
        "type": "appContains",
        "pattern": "detekt|ktlint|lint",
        "pathRegex": "(^|/)build\\.gradle(\\.kts)?$"
      },
      "checker": {
        "type": "appScripts",
        "scripts": ["lint"]
      }
    },
    {
      "id": "type_check",
      "pillar": "Style",
      "level": 1,
      "scope": "app",
      "tv": {
        "type": "appFiles",
        "pathRegex": "(^|/)build\\.gradle(\\.kts)?$"
      },
      "checker": {
        "type": "appScripts",
        "scripts": ["typecheck"]
      }
    },
    {
      "id": "strict_typing",
      "pillar": "Style",
      "level": 2,
      "scope": "app",
      "tv": {
        "type": "appFiles",
        "pathRegex": "(^|/)build\\.gradle(\\.kts)?$"
      },
      "checker": {
        "type": "appTsconfigStrict"
      }
    },
    {
      "id": "pre_commit_hooks",
      "pillar": "Style",
      "level": 2,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": ["lefthook.yml"]
          },
          {
            "type": "contains",
            "file": "lefthook.yml",
            "pattern": "pre-commit"
          }
        ]
      }
    },
    {
      "id": "large_file_detection",
      "pillar": "Style",
      "level": 3,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": ["scripts/check-large-files.mjs"]
          },
          {
            "type": "contains",
            "file": "lefthook.yml",
            "pattern": "check-large-files"
          }
        ]
      }
    },
    {
      "id": "naming_consistency",
      "pillar": "Style",
      "level": 3,
      "scope": "app",
      "tv": {
        "type": "contains",
        "file": "detekt.yml",
        "pattern": "Naming"
      },
      "checker": {
        "type": "contains",
        "file": "eslint.config.mjs",
        "pattern": "naming-convention"
      }
    },
    {
      "id": "cyclomatic_complexity",
      "pillar": "Style",
      "level": 4,
      "scope": "app",
      "tv": {
        "type": "contains",
        "file": "detekt.yml",
        "pattern": "Complexity"
      },
      "checker": {
        "type": "contains",
        "file": "eslint.config.mjs",
        "pattern": "complexity: \\['error'"
      }
    },
    {
      "id": "dead_code_detection",
      "pillar": "Style",
      "level": 4,
      "scope": "app",
      "tv": {
        "type": "skip",
        "reason": "Kotlin: covered by Android lint (UnusedResources)"
      },
      "checker": {
        "type": "knipWorkspace"
      }
    },
    {
      "id": "duplicate_code_detection",
      "pillar": "Style",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": [".jscpd.json"]
          },
          {
            "type": "rootScripts",
            "scripts": ["dup"]
          }
        ]
      }
    },
    {
      "id": "code_modularization",
      "pillar": "Style",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": [".dependency-cruiser.cjs"]
          },
          {
            "type": "rootScripts",
            "scripts": ["deps:check"]
          }
        ]
      }
    },
    {
      "id": "tech_debt_tracking",
      "pillar": "Style",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": ["scripts/techdebt.mjs", "docs/TECH_DEBT.md"]
          },
          {
            "type": "rootScripts",
            "scripts": ["techdebt"]
          }
        ]
      }
    },
    {
      "id": "n_plus_one_detection",
      "pillar": "Style",
      "level": 4,
      "scope": "app",
      "checker": {
        "type": "skip",
        "reason": "No ORM: node:sqlite with hand-written prepared statements"
      }
    },
    {
      "id": "build_cmd_doc",
      "pillar": "Build",
      "level": 1,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": ["README.md", "AGENTS.md"]
          },
          {
            "type": "contains",
            "file": "README.md",
            "pattern": "pnpm (install|build)"
          }
        ]
      }
    },
    {
      "id": "deps_pinned",
      "pillar": "Build",
      "level": 1,
      "scope": "repo",
      "checker": {
        "type": "files",
        "all": ["pnpm-lock.yaml"]
      }
    },
    {
      "id": "single_command_setup",
      "pillar": "Build",
      "level": 3,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": ["scripts/bootstrap.mjs"]
          },
          {
            "type": "rootScripts",
            "scripts": ["bootstrap"]
          },
          {
            "type": "contains",
            "file": "README.md",
            "pattern": "bootstrap"
          }
        ]
      }
    },
    {
      "id": "unused_dependencies_detection",
      "pillar": "Build",
      "level": 4,
      "scope": "app",
      "tv": {
        "type": "skip",
        "reason": "Gradle dependency analysis not configured; Android lint covers unused resources only"
      },
      "checker": {
        "type": "knipWorkspace"
      }
    },
    {
      "id": "version_drift_detection",
      "pillar": "Build",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": [".syncpackrc.json"]
          },
          {
            "type": "rootScripts",
            "scripts": ["syncpack:lint"]
          }
        ]
      }
    },
    {
      "id": "monorepo_tooling",
      "pillar": "Build",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": ["turbo.json"]
          },
          {
            "type": "contains",
            "file": "package.json",
            "pattern": "turbo run"
          }
        ]
      }
    },
    {
      "id": "build_performance_tracking",
      "pillar": "Build",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": ["turbo.json"]
          },
          {
            "type": "contains",
            "file": ".github/workflows/ci.yml",
            "pattern": "turbo"
          },
          {
            "type": "rootScripts",
            "scripts": ["build:summary"]
          }
        ]
      }
    },
    {
      "id": "heavy_dependency_detection",
      "pillar": "Build",
      "level": 4,
      "scope": "app",
      "appliesTo": ["web", "desktop"],
      "checker": {
        "type": "appContains",
        "pattern": "size-limit|rollup-plugin-visualizer|analyze",
        "pathRegex": "(^|/)package\\.json$"
      }
    },
    {
      "id": "deployment_frequency",
      "pillar": "Build",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "gh",
        "check": "releases"
      }
    },
    {
      "id": "release_automation",
      "pillar": "Build",
      "level": 3,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": [".github/workflows/release.yml", "scripts/next-version.mjs"]
          },
          {
            "type": "contains",
            "file": ".github/workflows/release.yml",
            "pattern": "workflow_run"
          }
        ]
      }
    },
    {
      "id": "release_notes_automation",
      "pillar": "Build",
      "level": 3,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": [".github/release.yml"]
          },
          {
            "type": "contains",
            "file": ".github/workflows/release.yml",
            "pattern": "generate-notes"
          }
        ]
      }
    },
    {
      "id": "rollback_automation",
      "pillar": "Build",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "skip",
        "reason": "Desktop and LAN app, not an infrastructure deployment; docs/runbooks/rollback.md documents reinstalling the previous release"
      }
    },
    {
      "id": "progressive_rollout",
      "pillar": "Build",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": ["docs/experimentation.md"]
          },
          {
            "type": "contains",
            "file": "docs/experimentation.md",
            "pattern": "rollout",
            "flags": "i"
          }
        ]
      }
    },
    {
      "id": "feature_flag_infrastructure",
      "pillar": "Build",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": ["packages/shared/src/flags.ts"]
          },
          {
            "type": "contains",
            "file": "packages/shared/src/flags.ts",
            "pattern": "posthog|PostHog",
            "flags": "i"
          }
        ]
      }
    },
    {
      "id": "dead_feature_flag_detection",
      "pillar": "Build",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "files",
            "all": ["scripts/flags.mjs"]
          },
          {
            "type": "rootScripts",
            "scripts": ["flags:check"]
          }
        ]
      }
    },
    {
      "id": "vcs_cli_tools",
      "pillar": "Build",
      "level": 2,
      "scope": "repo",
      "checker": {
        "type": "gh",
        "check": "auth"
      }
    },
    {
      "id": "agentic_development",
      "pillar": "Build",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "git",
        "check": "coauthor"
      }
    },
    {
      "id": "automated_pr_review",
      "pillar": "Build",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "skip",
        "reason": "Optional Droid review workflow needs a Factory secret (tracked as a GitHub issue); all work lands on main"
      }
    },
    {
      "id": "fast_ci_feedback",
      "pillar": "Build",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "gh",
        "check": "ciDuration"
      }
    },
    {
      "id": "unit_tests_exist",
      "pillar": "Testing",
      "level": 1,
      "scope": "app",
      "library": true,
      "checker": {
        "type": "appFiles",
        "pathRegex": "\\.(test|spec)\\.(ts|tsx|mjs)$|(^|/)src/test/.*\\.kt$"
      }
    },
    {
      "id": "unit_tests_runnable",
      "pillar": "Testing",
      "level": 1,
      "scope": "app",
      "library": true,
      "tv": {
        "type": "appFiles",
        "pathRegex": "(^|/)gradlew(\\.bat)?$"
      },
      "checker": {
        "type": "appScripts",
        "scripts": ["test"]
      }
    },
    {
      "id": "test_naming_conventions",
      "pillar": "Testing",
      "level": 2,
      "scope": "app",
      "library": true,
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "appFiles",
            "pathRegex": "\\.test\\.(ts|tsx)$|Test\\.kt$"
          },
          {
            "type": "files",
            "all": ["AGENTS.md"]
          },
          {
            "type": "contains",
            "file": "AGENTS.md",
            "pattern": "\\*\\.test\\.ts"
          }
        ]
      }
    },
    {
      "id": "test_isolation",
      "pillar": "Testing",
      "level": 2,
      "scope": "app",
      "library": true,
      "checker": {
        "type": "all",
        "checks": [
          {
            "type": "appFiles",
            "pathRegex": "(^|/)vitest\\.config\\.ts$|(^|/)vite\\.config\\.ts$|(^|/)build\\.gradle(\\.kts)?$"
          },
          {
            "type": "contains",
            "file": "AGENTS.md",
            "pattern": "PORT=0"
          }
        ]
      }
    },
    {
      "id": "integration_tests_exist",
      "pillar": "Testing",
      "level": 3,
      "scope": "app",
      "tv": {
        "type": "appFiles",
        "pathRegex": "(^|/)src/androidTest/"
      },
      "checker": {
        "type": "appFiles",
        "pathRegex": "(^|/)(test/integration|e2e|src/androidTest)/"
      }
    },
    {
      "id": "test_coverage_thresholds",
      "pillar": "Testing",
      "level": 3,
      "scope": "app",
      "library": true,
      "tv": {
        "type": "appContains",
        "pattern": "jacocoTestCoverageVerification",
        "pathRegex": "(^|/)build\\.gradle(\\.kts)?$"
      },
      "checker": {
        "type": "appFiles",
        "pathRegex": "(^|/)coverage-thresholds\\.json$"
      }
    },
    {
      "id": "flaky_test_detection",
      "pillar": "Testing",
      "level": 4,
      "scope": "repo",
      "checker": {
        "type": "all",
        "checks": [
