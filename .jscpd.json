{
  "path": ["apps", "packages", "scripts"],
  "format": ["typescript", "tsx", "javascript", "jsx"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/reports/**",
    "**/test/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.d.mts",
    "apps/tv/**"
  ],
  "minLines": 8,
  "minTokens": 90,
  "threshold": 5,
  "reporters": ["console", "json"],
  "output": "reports/jscpd",
  "gitignore": true,
  "absolute": false
}