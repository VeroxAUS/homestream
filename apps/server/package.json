{
  "name": "@homestream/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --filter @homestream/shared build && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:gpu": "vitest run --project gpu",
    "test:live": "vitest run --project live",
    "test:ci": "vitest run --project unit --project integration",
    "test:coverage": "vitest run --coverage --project unit --project integration"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/static": "^10.1.8",
    "@homestream/shared": "workspace:*",
    "bonjour-service": "^1.4.4",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
