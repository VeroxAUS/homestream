{
  "name": "@homestream/web",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "analyze": "vite build --mode analyze --outDir reports/analyze-dist",
    "size": "size-limit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node e2e/build.mjs && playwright test"
  },
  "dependencies": {
    "@homestream/shared": "workspace:*",
    "@sentry/react": "~11.10.0",
    "@tanstack/react-query": "^5.106.1",
    "hls.js": "^1.7.4",
    "posthog-js": "~1.446.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.1",
    "@sentry/vite-plugin": "~11.10.0",
    "@size-limit/file": "~14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "rollup-plugin-visualizer": "^7.1.2",
    "size-limit": "~14.3.0",
    "vite": "^8.3.5"
  }
}
