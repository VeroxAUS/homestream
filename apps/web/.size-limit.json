[
  {
    "name": "Initial JavaScript (gzip)",
    "path": "dist/assets/index-*.js",
    "gzip": true,
    "limit": "150 kB"
  },
  {
    "name": "All CSS (gzip)",
    "path": "dist/assets/*.css",
    "gzip": true,
    "limit": "24 kB"
  },
  {
    "name": "Route chunks together (gzip)",
    "path": ["dist/assets/*Page-*.js", "!dist/assets/PlayerPage-*.js"],
    "gzip": true,
    "limit": "40 kB"
  },
  {
    "name": "Player chunk with hls.js (gzip)",
    "path": "dist/assets/PlayerPage-*.js",
    "gzip": true,
    "limit": "210 kB"
  },
  {
    "name": "Inter font",
    "path": "dist/assets/inter-var-*.woff2",
    "gzip": false,
    "limit": "50 kB"
  },
  {
    "name": "Telemetry chunk (gzip)",
    "path": "dist/assets/telemetry-*.js",
    "gzip": true,
    "limit": "100 kB"
  }
]
