{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", "vitest.shared.ts", "pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "HOMESTREAM_TELEMETRY",
        "HOMESTREAM_TELEMETRY_STUB",
        "HOMESTREAM_RELEASE_BUILD",
        "POSTHOG_API_KEY",
        "POSTHOG_HOST",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_DSN_WEB",
        "SENTRY_ENVIRONMENT",
        "SENTRY_ORG",
        "SENTRY_RELEASE"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "cache": false
    },
    "test:ci": {
      "dependsOn": ["^test:ci"],
      "outputs": []
    }
  }
}
